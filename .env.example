# Токен бота (получить у @BotFather)
BOT_TOKEN=

# Юзернейм бота (без @)
BOT_USERNAME=

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bot_4_rates_uz
DB_USER=bot_4_rates_uz
DB_PASSWORD=

# Список ID администраторов через запятую (получить у @userinfobot)
ADMIN_IDS=
ADMIN_USERNAME=admin

# Интервалы обновления курсов (в минутах)
CBU_REFRESH_MIN=60
BANKS_REFRESH_MIN=30
CRYPTO_REFRESH_MIN=5

# Время ежедневного дайджеста (HH:MM, локальное время)
DAILY_DIGEST_TIME=09:00

# Временная зона для дайджеста и отображения времени
TIMEZONE=Asia/Tashkent
